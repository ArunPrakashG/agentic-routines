{
  "name": "agentic-routines-monorepo",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:up": "dev/env/up.sh",
    "dev:down": "dev/env/down.sh",
    "e2e": "dev/e2e/e2e.sh",
    "test:all": "dev/test-all.sh",
    "e2e:api": "node dev/e2e/e2e-api.mjs",
    "e2e:sources": "node dev/e2e/e2e-sources.mjs",
    "e2e:agents": "node dev/e2e/e2e-agents.mjs",
    "e2e:hooks": "dev/e2e/e2e-hooks.sh",
    "check:links": "node dev/check-links.mjs",
    "readme:images": "dev/images/readme-images.sh",
    "check:store": "node releases/scripts/check-store.mjs",
    "release": "node releases/scripts/build.mjs",
    "release:version": "node releases/scripts/version.mjs",
    "release:bundle": "node releases/scripts/bundle.mjs",
    "release:private": "node releases/scripts/publish-private.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.18.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1"
    }
  }
}
