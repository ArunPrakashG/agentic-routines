---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  jsonLd?: object;
  dark?: boolean;
}
const { title, description, path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/?index$/, '/'), noindex = false, jsonLd, dark = false } = Astro.props;
const canonical = new URL(path, Astro.site).toString().replace(/\/$/, '') || String(Astro.site);
const full = title === 'Agentic Routines' ? 'Agentic Routines · Teach your agent a browser chore once' : `${title} · Agentic Routines`;
const image = new URL('/og.png', Astro.site).toString();
const here = Astro.url.pathname.replace(/\.html$/, '');
const REPO = 'https://github.com/ArunPrakashG/agentic-routines';
const nav = [
  { href: '/#how', label: 'How it works' },
  { href: '/directory', label: 'Directory' },
  { href: '/docs', label: 'Docs' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Agentic Routines" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Agentic Routines: teach your agent a browser chore once. It replays without the model." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class:list={['top', { 't-dark': dark }]}>
      <div class="wrap">
        <header class="topbar">
          <a class="brand" href="/" aria-label="Agentic Routines, home">
            <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 5.5h12L5 11h12L7 16.5h13" fill="none" stroke="var(--accent-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Agentic Routines</span>
          </a>
          <nav class="topnav" aria-label="Main">
            {nav.map((n) => <a class="nav hide-sm" href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a>)}
            <a class="btn btn-secondary" href={REPO} style="margin-left: 8px; gap: 8px;">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
              GitHub
            </a>
          </nav>
        </header>
      </div>
    </div>
    <main id="main"><slot /></main>
    <footer class="site">
      <div class="wrap in">
        <div>
          <a class="brand" href="/">Agentic Routines</a>
          <p>Free and open source under MIT.</p>
        </div>
        <nav aria-label="Footer">
          <a class="nav" href={REPO}>GitHub</a>
          <a class="nav" href="/docs">Docs</a>
          <a class="nav" href="/directory">Directory</a>
          <a class="nav" href="/guidelines">Guidelines</a>
          <a class="nav" href={`${REPO}/releases`}>Releases</a>
          <a class="nav" href="/privacy">Privacy</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
