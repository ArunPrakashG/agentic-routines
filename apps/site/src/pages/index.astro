  }
</style>

<script>
  const copy = document.getElementById('copy-prompt');
  const prompt = document.getElementById('setup-prompt');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(prompt?.textContent ?? '');
      copy.textContent = 'Copied';
    } catch {
      // No clipboard access: select the text so it can be copied by hand.
      const range = document.createRange();
      if (prompt) range.selectNodeContents(prompt);
      const sel = getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
      copy.textContent = 'Press Ctrl+C';
    }
    setTimeout(() => { copy.textContent = copy.dataset.label ?? 'Copy instructions'; }, 2000);
  });
</script>
