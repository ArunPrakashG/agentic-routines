---
import Base from '../layouts/Base.astro';
import Agents from '../components/Agents.astro';

const REPO = 'https://github.com/ArunPrakashG/agentic-routines';
type Row = { task: string; note: string; tokens: string[]; time: string[]; cost: string[] };
const rows: Row[] = [
  { task: 'Edit a YouTube description', note: 'Real YouTube, signed in', tokens: ['539k', '97k', '−82%'], time: ['0:56', '0:19', '−66%'], cost: ['$0.21', '$0.04', '−81%'] },
  { task: 'Release a build to testers', note: 'Store console replica, one form', tokens: ['530k', '109k', '−79%'], time: ['0:26', '0:10', '−63%'], cost: ['$0.10', '$0.02', '−82%'] },
  { task: 'Release with every setting', note: 'The same console, a long form', tokens: ['1.29M', '339k', '−74%'], time: ['0:57', '0:28', '−50%'], cost: ['$0.29', '$0.09', '−69%'] },
  { task: 'The same release, a button renamed', note: 'Your agent fixed one step', tokens: ['1.29M', '381k', '−71%'], time: ['0:57', '0:38', '−33%'], cost: ['$0.29', '$0.07', '−75%'] },
];
const steps = [
  { h: 'Your agent does the task', p: 'As it does today, in your own browser with your sign-ins. Every step is recorded.' },
  { h: 'It keeps the ones worth keeping', p: 'Clicks a link can replace are dropped. Values that change each time become inputs.' },
  { h: 'Next time it is one call', p: 'No model unless the page changed. Then only that one step goes to your agent.' },
];
const safe = [
  { h: 'Checks the page before every step', p: 'Same page: it runs straight through. A step moved: only that step goes to your agent, and the fix is kept.' },
  { h: 'Pauses before anything you can’t undo', p: 'Publishing, paying, deleting. It waits for you, or for your agent to say yes.' },
  { h: 'Never keeps a password', p: 'Typed secrets are recorded as a placeholder. Agents only ever see a secret’s name.' },
  { h: 'Stays on its own site', p: 'A routine only works on the site it was recorded on, whatever a page says.' },
  { h: 'Hands back when it breaks', p: 'Your agent picks up from the failed step, with everything done so far.' },
  { h: 'Learns from you too', p: 'Do the task yourself once in the side panel. It saves the same way.' },
];
const open = [
  { h: 'No account, no server', p: 'Recording and replaying never leave your machine. Sign-in is only for publishing to the directory.' },
  { h: 'Routines are plain files', p: 'Markdown you can read and diff. Keep them on your computer, or in your project’s repository so the team reviews them in pull requests and every agent started there finds them.' },
  { h: 'Built in the open', p: 'Issues, releases and the benchmark are on GitHub. Bug reports and pull requests are welcome.' },
];
// Direct store entries go in here once the listings are live; until then each opens the store's search.
const stores = [
  { id: 'chrome', name: 'Chrome', store: 'the Chrome Web Store', href: 'https://chromewebstore.google.com/search/agentic%20routines' },
  { id: 'edge', name: 'Edge', store: 'Microsoft Edge Add-ons', href: 'https://microsoftedge.microsoft.com/addons/search/agentic%20routines' },
  { id: 'firefox', name: 'Firefox', store: 'Firefox Add-ons', href: 'https://addons.mozilla.org/firefox/search/?q=agentic+routines' },
];
const prompt = `Set up Agentic Routines (open source, github.com/ArunPrakashG/agentic-routines) on this machine.
1. Run "npx agentic-routines setup". If I use pnpm, bun or yarn, run it with "pnpm dlx", "bunx" or "yarn dlx" instead.
2. Run "npx agentic-routines doctor" and tell me which agents and browsers are connected and what is still missing.
3. If my browser has no extension yet, tell me which store to get it from: Chrome Web Store, Microsoft Edge Add-ons or Firefox Add-ons. Do not install anything else.
4. Tell me to restart this agent so it loads the browser tools.`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Agentic Routines',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Chrome, Edge, Firefox',
  description: 'Open source tool that records what your AI coding agent does in the browser and replays it without the model.',
  license: 'https://opensource.org/licenses/MIT',
  codeRepository: REPO,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const check = '<path d="M20 6 9 17l-5-5"/>';
---
<Base
  title="Agentic Routines"
  description="Agentic Routines is open source. Teach your coding agent a browser chore once and it replays without the model: up to 82% cheaper and 2.7 times faster on long chores."
  path="/"
  jsonLd={ld}
  dark
>
  <section class="hero t-dark">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <a class="chip mono" href={REPO} target="_blank" rel="noopener"><i aria-hidden="true"></i>Open source · MIT</a>
        <h1>Teach your agent a browser chore once. It replays without the model.</h1>
        <p class="sub">Agentic Routines records what your coding agent does in your browser and keeps it as a routine. Next time the whole chore replays without the model: no reading pages, no tokens, the same steps.</p>
        <div class="cta">
          <a class="btn btn-primary btn-lg" href={REPO} target="_blank" rel="noopener">Star on GitHub</a>
          <a class="btn btn-secondary btn-lg" href="#how">How it works</a>
        </div>
        <Agents />
      </div>

      <div class="setup">
        <div class="setup-h">
          <strong>Paste this into your agent</strong>
          <span>It sets everything up</span>
        </div>
        <pre id="setup-prompt">{prompt}</pre>
        <div class="setup-f">
          <span>Or run <code>npx agentic-routines setup</code></span>
          <button type="button" class="btn btn-primary btn-lg" id="copy-prompt" data-label="Copy">Copy</button>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="how">
    <div class="wrap stack">
      <div class="head">
        <span class="k mono">How it works</span>
        <h2 class="h2">The first run is your agent. Every run after is a replay.</h2>
        <p class="lede">Browser agents read the page, think and act for every single step, and they pay for all of it again tomorrow. A routine keeps the steps, so the next run skips the thinking.</p>
      </div>
      <ol class="g3">
        {steps.map((s, i) => (
          <li class="card">
            <span class="n mono">{i + 1}</span>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
            {i === 0 && <pre class="code" aria-label="A recorded run">navigate  play.google.com/console
click     Kavyam
click     Testing
click     Create new release
<span class="dim">… 21 more</span></pre>}
            {i === 1 && <pre class="code" aria-label="The saved routine">navigate  …/releases/new  <span class="tag">direct</span>
upload    <span class="tag">{'{{bundle}}'}</span>
type      Release name  <span class="tag">{'{{version_name}}'}</span>
click     Next
<span class="dim">… 16 more</span></pre>}
            {i === 2 && <pre class="code" aria-label="Replaying it with one call"><span class="fn">routine_run</span>(<span class="str">"play-release"</span>, {'{'}
  version_name: <span class="str">"2.15.0 (215)"</span>,
  bundle: <span class="str">"kavyam-2.15.0.aab"</span>
{'}'})</pre>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec" id="numbers">
    <div class="wrap stack">
      <div class="head">
        <span class="k mono">Measured</span>
        <h2 class="h2">Up to 82% cheaper and 2.7 times faster.</h2>
        <p class="lede">The same agent doing the same task by hand, against replaying the routine it saved.</p>
      </div>
      <dl class="stats">
        <div><dt>fewer tokens</dt><dd>−82%</dd></div>
        <div><dt>less time</dt><dd>−66%</dd></div>
        <div><dt>lower cost</dt><dd>−81%</dd></div>
      </dl>
      <div class="tbl" role="table" aria-label="By hand against replay">
        <div class="tr th" role="row"><span role="columnheader">Task</span><span role="columnheader">Tokens</span><span role="columnheader">Time</span><span role="columnheader">Cost</span></div>
        {rows.map((r) => (
          <div class="tr" role="row">
            <span class="task" role="cell"><b>{r.task}</b><small>{r.note}</small></span>
            {[['Tokens', r.tokens], ['Time', r.time], ['Cost', r.cost]].map(([l, v]) => (
              <span class="m" role="cell" data-l={l as string}><span class="mono">{(v as string[])[0]} → <b>{(v as string[])[1]}</b></span><em class="mono">{(v as string[])[2]}</em></span>
            ))}
          </div>
        ))}
      </div>
      <p class="fine">Medians of 3 to 5 runs with Claude Sonnet 5.5, costs at list prices as Claude Code reported them. Long chores gain the most; a one-step lookup costs more as a routine, so your agent does not save those. The benchmark is in the <a href={`${REPO}/tree/main/dev/bench`} target="_blank" rel="noopener">repository</a>, so you can run it yourself.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap stack">
      <div class="head">
        <span class="k mono">Safe by default</span>
        <h2 class="h2">It stops where you would.</h2>
      </div>
      <div class="safe">
        {safe.map((s) => <div><h3>{s.h}</h3><p>{s.p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="sec" id="open-source">
    <div class="wrap oss">
      <div class="stack oss-copy">
        <div class="head">
          <span class="k mono">Open source</span>
          <h2 class="h2">Free, open, and on your computer.</h2>
          <p class="lede">The extension, the agent tools and the replay engine are all in one MIT-licensed repository. Read it, run it from source, change it.</p>
        </div>
        <ul class="list">
          {open.map((o) => (
            <li>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check} />
              <div><h3>{o.h}</h3><p>{o.p}</p></div>
            </li>
          ))}
        </ul>
        <div class="cta">
          <a class="btn btn-primary btn-lg" href={REPO} target="_blank" rel="noopener">Star on GitHub</a>
          <a class="btn btn-secondary btn-lg" href={`${REPO}/issues`} target="_blank" rel="noopener">Report an issue</a>
        </div>
      </div>
      <figure class="file">
        <figcaption class="mono">~/.agentic-routines/routines/local/play-release/ROUTINE.md</figcaption>
        <pre><span class="dim">---</span>
name: play-release
site: play.google.com
description: Release a build to internal testing.
  Use when shipping a new Android build to testers.
params:
  version_name: Release name, like 2.15.0 (215)
  bundle: Absolute path of the .aab
<span class="dim">---</span>
1. navigate …/tracks/internal/releases/new
2. upload “App bundle” <span class="tag">{'{{bundle}}'}</span>
3. type “Release name” <span class="tag">{'{{version_name}}'}</span>
4. click “Next”
<span class="dim">…</span>
9. click “Start rollout”  <span class="dim">pauses first</span></pre>
      </figure>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="band">
        <div class="head">
          <h2 class="h2">Routines other people keep working.</h2>
          <p class="lede">Install one someone else maintains and your agent never pays to record it. Every routine is read by a person before it is listed.</p>
        </div>
        <div class="cta">
          <a class="btn btn-primary btn-lg" href="/directory">Browse the directory</a>
          <a class="btn btn-secondary btn-lg" href="/guidelines">Publish yours</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="install">
    <div class="wrap stack">
      <div class="head">
        <span class="k mono">By hand</span>
        <h2 class="h2">Rather set it up yourself?</h2>
      </div>
      <ol class="g2">
        <li class="card">
          <span class="n mono">1</span>
          <h3>Add the extension</h3>
          <div class="stores">
            {stores.map((s) => (
              <a class="btn btn-secondary btn-lg" href={s.href} target="_blank" rel="noopener" aria-label={`Add to ${s.name}, opens ${s.store}`}>
                <img src={`/browsers/${s.id}.svg`} alt="" width="20" height="20" />{s.name}
              </a>
            ))}
          </div>
          <p>Brave, Arc and Opera use the Chrome version. Or load it from a <a href={`${REPO}/releases/latest`} target="_blank" rel="noopener">release</a> or a build of the repository: <a href="/docs/quickstart">Try it now</a>.</p>
        </li>
        <li class="card">
          <span class="n mono">2</span>
          <h3>Connect your agents</h3>
          <pre class="term" aria-label="Terminal"><span class="dim">$</span> npx agentic-routines setup
<span class="ok">✓</span> Claude Code  <span class="dim">~/.claude.json</span>
<span class="ok">✓</span> Codex        <span class="dim">~/.codex/config.toml</span>
<span class="ok">✓</span> Chrome       <span class="dim">extension connected</span></pre>
          <p>pnpm dlx, bunx and yarn dlx work too. <code>doctor</code> says what is still missing.</p>
        </li>
      </ol>
    </div>
  </section>
</Base>

<style is:global>
  .top.t-dark { background: var(--bg); color: var(--text-1); }
  .hero { background: var(--bg); color: var(--text-1); }
  .hero-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 560px); gap: 56px; align-items: center; padding-top: 56px; padding-bottom: 96px; }
  .hero-copy { display: flex; flex-direction: column; gap: 26px; min-width: 0; }
  .chip { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; padding: 7px 12px; border: 1px solid var(--border-strong); border-radius: 999px; font-size: 13px; color: var(--text-2); text-decoration: none; }
  .chip:hover { color: var(--text-1); background: var(--surface-2); }
  .chip i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .hero h1 { margin: 0; font-size: 56px; line-height: 60px; font-weight: 600; letter-spacing: -0.035em; text-wrap: balance; }
  .hero .sub { margin: 0; font-size: 18px; line-height: 28px; color: var(--text-2); max-width: 540px; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; }

  .setup { border: 1px solid var(--border-strong); border-radius: 16px; background: var(--surface-1); box-shadow: var(--shadow-2); overflow: hidden; min-width: 0; }
  .setup-h { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
  .setup-h strong { font-size: 15px; font-weight: 500; }
  .setup-h span { font-size: 13px; color: var(--text-3); }
  .setup pre { margin: 0; padding: 20px; font: 400 13px/22px var(--font-mono); color: var(--text-1); white-space: pre-wrap; overflow-wrap: anywhere; user-select: all; }
  .setup-f { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 20px; background: var(--surface-2); border-top: 1px solid var(--border); font-size: 13px; color: var(--text-2); }
  .setup-f code, .card code { font-family: var(--font-mono); color: var(--text-1); }

  .stack { display: flex; flex-direction: column; gap: 44px; }
  .head { display: flex; flex-direction: column; gap: 14px; max-width: 720px; }
  .k { font-size: 12px; font-weight: 500; color: var(--accent-ink); text-transform: uppercase; letter-spacing: 0.04em; }
  h3 { margin: 0; font-size: 17px; line-height: 24px; font-weight: 500; }
  .card p, .safe p, .list p { margin: 0; font-size: 15px; line-height: 23px; color: var(--text-2); }
  .card p a { color: var(--accent-ink); }
  .g3, .g2 { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; }
  .g3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .g2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .card { display: flex; flex-direction: column; gap: 12px; padding: 24px; border: 1px solid var(--border); border-radius: 14px; background: var(--surface-1); min-width: 0; }
  .n { width: 28px; height: 28px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-ink); display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 500; }
  .code, .term { margin: 0; padding: 14px 16px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface-2); font: 400 12px/20px var(--font-mono); color: var(--text-1); white-space: pre; overflow-x: auto; }
  .term { font-size: 13px; line-height: 22px; }
  .dim { color: var(--text-3); }
  .tag { background: var(--accent-soft); color: var(--accent-ink); border-radius: 4px; padding: 1px 6px; }
  .code .fn, .term .ok { color: var(--accent-ink); }
  .code .str { color: var(--text-2); }

  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 0; }
  .stats div { display: flex; flex-direction: column-reverse; gap: 6px; padding-top: 18px; border-top: 2px solid var(--accent); }
  .stats dd { margin: 0; font: 500 52px/1 var(--font-mono); letter-spacing: -0.03em; color: var(--accent-ink); }
  .stats dt { font-size: 15px; color: var(--text-2); }
  .tbl { border: 1px solid var(--border); border-radius: 14px; background: var(--surface-1); overflow: hidden; }
  .tr { display: grid; grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)); gap: 16px; padding: 16px 20px; align-items: center; border-top: 1px solid var(--border); }
  .tr:first-child { border-top: 0; }
  .tr.th { font-size: 12px; color: var(--text-3); background: var(--surface-2); padding-top: 10px; padding-bottom: 10px; }
  .tr .task { display: flex; flex-direction: column; gap: 2px; }
  .tr .task b { font-weight: 500; font-size: 15px; }
  .tr .task small { font-size: 12px; color: var(--text-3); }
  .tr .m { display: flex; flex-direction: column; gap: 2px; font-size: 14px; color: var(--text-2); }
  .tr .m b { color: var(--text-1); font-weight: 500; }
  .tr .m em { font-style: normal; font-size: 12px; color: var(--accent-ink); }
  .fine { margin: 0; font-size: 12px; line-height: 18px; color: var(--text-3); max-width: 760px; }
  .fine a { color: inherit; }

  .safe { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 32px; }
  .safe div { display: flex; flex-direction: column; gap: 8px; padding-top: 18px; border-top: 1px solid var(--border-strong); }

  .oss { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 520px); gap: 56px; align-items: start; }
  .oss-copy { gap: 32px; }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 22px; }
  .list li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 14px; }
  .list svg { margin-top: 2px; }
  .list div { display: flex; flex-direction: column; gap: 4px; }
  .file { margin: 0; border: 1px solid var(--border); border-radius: 14px; background: var(--surface-1); overflow: hidden; min-width: 0; }
  .file figcaption { padding: 12px 16px; border-bottom: 1px solid var(--border); font-size: 12px; color: var(--text-3); overflow-wrap: anywhere; }
  .file pre { margin: 0; padding: 16px; font: 400 12px/20px var(--font-mono); white-space: pre; overflow-x: auto; }

  .band { display: flex; align-items: center; justify-content: space-between; gap: 24px 40px; flex-wrap: wrap; padding: 36px 40px; border: 1px solid var(--border); border-radius: 16px; background: var(--surface-1); }
  .band .head { max-width: 620px; }
  .stores { display: flex; gap: 8px; flex-wrap: wrap; }
  .stores .btn { gap: 10px; }
  .stores img { display: block; }

  @media (max-width: 1100px) {
    .hero-in, .oss { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .setup, .file { max-width: 680px; }
  }
  @media (max-width: 900px) {
    .g3, .g2, .safe, .stats { grid-template-columns: minmax(0, 1fr); }
    .stack { gap: 32px; }
  }
  @media (max-width: 640px) {
    .hero-in { padding-top: 32px; padding-bottom: 56px; }
    .hero h1 { font-size: 38px; line-height: 42px; }
    .hero .sub { font-size: 16px; line-height: 25px; }
    .cta .btn { flex: 1 1 100%; }
    .setup pre { padding: 16px; font-size: 12px; line-height: 20px; }
    .setup-h, .setup-f { padding: 12px 16px; }
    .setup-f { flex-direction: column; align-items: stretch; }
    .stats dd { font-size: 40px; }
    .tr { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.35fr); gap: 10px; padding: 14px 16px; }
    .tr .task { grid-column: 1 / -1; }
    .tr.th { display: none; }
    .tr .m::before { content: attr(data-l); font: 400 11px/1 var(--font-sans); color: var(--text-3); }
    .tr .m { font-size: 12px; }
    .card { padding: 20px 16px; }
    .band { padding: 24px 16px; }
  }
</style>

<script>
  const copy = document.getElementById('copy-prompt');
  const prompt = document.getElementById('setup-prompt');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(prompt?.textContent ?? '');
      copy.textContent = 'Copied';
    } catch {
      // No clipboard access: select the text so it can be copied by hand.
      const range = document.createRange();
      if (prompt) range.selectNodeContents(prompt);
      const sel = getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
      copy.textContent = 'Press Ctrl+C';
    }
    setTimeout(() => { copy.textContent = copy.dataset.label ?? 'Copy'; }, 2000);
  });
</script>
