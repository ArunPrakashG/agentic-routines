  .stores img { display: block; }
  .runs { display: grid; grid-template-columns: 48px minmax(0, 1fr); margin-bottom: 8px; }
  .or { display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--text-3); }
  .or span { flex: 1; height: 1px; background: var(--border); }
  .prompt { display: flex; flex-direction: column; gap: 14px; padding: 16px 20px; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; }
  .prompt pre { margin: 0; font: 400 13px/22px var(--font-mono); white-space: pre-wrap; user-select: all; }
  .prompt .btn { align-self: flex-end; }
  .term { font: 400 13px/22px var(--font-mono); background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; overflow-x: auto; white-space: nowrap; }
  .term .ok span:first-child { color: var(--accent-ink); }

  @media (max-width: 1100px) {
    .hero-in { grid-template-columns: minmax(0, 1fr); gap: 40px; padding-bottom: 72px; }
    .chart { max-width: 680px; }
  }
  @media (max-width: 900px) {
    .cols3, .flow { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .cols2 { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .pain { grid-template-columns: repeat(2, minmax(0, 1fr)); }
