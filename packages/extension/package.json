{
  "name": "@agentic-routines/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@agentic-routines/core": "workspace:*",
    "@preact/preset-vite": "^2.10.2",
    "wxt": "^0.21.5"
  }
}
